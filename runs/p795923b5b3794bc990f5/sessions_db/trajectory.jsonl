10+5+2+5+1+10 = 45. 45 mod 11 = 45-44=1. Not stable.\n\nn=2: powers of 2 mod 11: 2^0=1, 2^1=2, 2^2=4, 2^3=8, 2^4=16=5, 2^5=10, 2^6=20=9, 2^7=18=7, 2^8=14=3, 2^9=6, 2^10=12=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*2=2, 2*4=8, 6*8=48=48-44=4, 2*5=10, 10*10=100=100-99=1, 5*9=45=1, 2*7=14=3, 5*3=15=4, 1*6=6, 10*1=10\nsum: 1+2+8+4+10+1+1+3+4+6+10 = 50. 50 mod 11 = 50-44=6. Not stable.\n\nn=3: powers of 3 mod 11: 3^0=1, 3^1=3, 3^2=9, 3^3=27=5, 3^4=15=4, 3^5=12=1, 3^6=3, 3^7=9, 3^8=5, 3^9=4, 3^10=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*3=3, 2*9=18=7, 6*5=30=8, 2*4=8, 10*1=10, 5*3=15=4, 2*9=18=7, 5*5=25=3, 1*4=4, 10*1=10\nsum: 1+3+7+8+8+10+4+7+3+4+10 = 65. 65 mod 11 = 65-55=10. Not stable.\n\nn=4: powers of 4 mod 11: 4^0=1, 4^1=4, 4^2=16=5, 4^3=20=9, 4^4=36=3, 4^5=12=1, 4^6=4, 4^7=5, 4^8=9, 4^9=3, 4^10=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*4=4, 2*5=10, 6*9=54=54-44=10, 2*3=6, 10*1=10, 5*4=20=9, 2*5=10, 5*9=45=1, 1*3=3, 10*1=10\nsum: 1+4+10+10+6+10+9+10+1+3+10 = 74. 74 mod 11 = 74-66=8. Not stable.\n\nn=5: powers of 5 mod 11: 5^0=1, 5^1=5, 5^2=25=3, 5^3=15=4, 5^4=20=9, 5^5=45=1, 5^6=5, 5^7=3, 5^8=4, 5^9=9, 5^10=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*5=5, 2*3=6, 6*4=24=2, 2*9=18=7, 10*1=10, 5*5=25=3, 2*3=6, 5*4=20=9, 1*9=9, 10*1=10\nsum: 1+5+6+2+7+10+3+6+9+9+10 = 68. 68 mod 11 = 68-66=2. Not stable.\n\nn=6: powers of 6 mod 11: 6^0=1, 6^1=6, 6^2=36=3, 6^3=18=7, 6^4=42=9, 6^5=54=10, 6^6=60=5, 6^7=30=8, 6^8=48=4, 6^9=24=2, 6^10=12=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*6=6, 2*3=6, 6*7=42=9, 2*9=18=7, 10*10=100=1, 5*5=25=3, 2*8=16=5, 5*4=20=9, 1*2=2, 10*1=10\nsum: 1+6+6+9+7+1+3+5+9+2+10 = 59. 59 mod 11 = 59-55=4. Not stable.\n\nn=7: powers of 7 mod 11: 7^0=1, 7^1=7, 7^2=49=5, 7^3=35=2, 7^4=14=3, 7^5=21=10, 7^6=70=4, 7^7=28=6, 7^8=42=9, 7^9=63=8, 7^10=56=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*7=7, 2*5=10, 6*2=12=1, 2*3=6, 10*10=100=1, 5*4=20=9, 2*6=12=1, 5*9=45=1, 1*8=8, 10*1=10\nsum: 1+7+10+1+6+1+9+1+1+8+10 = 55. 55 mod 11 = 0. STABLE!\n\nn=8: powers of 8 mod 11: 8^0=1, 8^1=8, 8^2=64=9, 8^3=72=6, 8^4=48=4, 8^5=32=10, 8^6=80=3, 8^7=24=2, 8^8=16=5, 8^9=40=7, 8^10=56=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*8=8, 2*9=18=7, 6*6=36=3, 2*4=8, 10*10=100=1, 5*3=15=4, 2*2=4, 5*5=25=3, 1*7=7, 10*1=10\nsum: 1+8+7+3+8+1+4+4+3+7+10 = 56. 56 mod 11 = 56-55=1. Not stable.\n\nn=9: powers of 9 mod 11: 9^0=1, 9^1=9, 9^2=81=4, 9^3=36=3, 9^4=27=5, 9^5=45=1, 9^6=9, 9^7=4, 9^8=3, 9^9=5, 9^10=1.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*9=9, 2*4=8, 6*3=18=7, 2*5=10, 10*1=10, 5*9=45=1, 2*4=8, 5*3=15=4, 1*5=5, 10*1=10\nsum: 1+9+8+7+10+10+1+8+4+5+10 = 73. 73 mod 11 = 73-66=7. Not stable.\n\nn=10: powers of 10 mod 11: 10 ≡ -1. So 10^k = (-1)^k mod 11.\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1*1=1, 1*(-1)=-1=10, 2*1=2, 6*(-1)=-6=5, 2*1=2, 10*(-1)=-10=1, 5*1=5, 2*(-1)=-2=9, 5*1=5, 1*(-1)=-1=10, 10*1=10\nsum: 1+10+2+5+2+1+5+9+5+10+10 = 60. 60 mod 11 = 60-55=5. Not stable.\n\nSo only n=7 is stable. The answer is 1.\n\nWait, let me double-check n=7.\n\nn=7: powers of 7 mod 11: 7^0=1, 7^1=7, 7^2=49=49-44=5, 7^3=5*7=35=35-33=2, 7^4=2*7=14=3, 7^5=3*7=21=10, 7^6=10*7=70=70-66=4, 7^7=4*7=28=28-22=6, 7^8=6*7=42=42-33=9, 7^9=9*7=63=63-55=8, 7^10=8*7=56=56-55=1. ✓\n\nk! mod 11: 1,1,2,6,2,10,5,2,5,1,10 ✓\n\nproducts:\nk=0: 1*1=1\nk=1: 1*7=7\nk=2: 2*5=10\nk=3: 6*2=12=1\nk=4: 2*3=6\nk=5: 10*10=100=100-99=1\nk=6: 5*4=20=20-11=9\nk=7: 2*6=12=1\nk=8: 5*9=45=45-44=1\nk=9: 1*8=8\nk=10: 10*1=10\n\nsum: 1+7+10+1+6+1+9+1+1+8+10 = 55. 55 = 5*11. ✓ STABLE.\n\nSo only n=7. Maximum number of stable hubs = 1.\n\nLet me verify a couple more to be sure I didn't make arithmetic errors. Let me recheck n=1.\nS_1 = sum k! = 0!+1!+...+10! = 1+1+2+6+24+120+720+5040+40320+362880+3628800.\nMod 11: 1+1+2+6+2+10+5+2+5+1+10 = 45. 45 mod 11 = 1. ✓\n\nLet me recheck n=10 more carefully.\n10 ≡ -1 mod 11.\nS_10 = sum k! * (-1)^k mod 11.\nk=0: 1*1=1\nk=1: 1*(-1)=-1\nk=2: 2*1=2\nk=3: 6*(-1)=-6\nk=4: 2*1=2\nk=5: 10*(-1)=-10\nk=6: 5*1=5\nk=7: 2*(-1)=-2\nk=8: 5*1=5\nk=9: 1*(-1)=-1\nk=10: 10*1=10\nsum = 1-1+2-6+2-10+5-2+5-1+10 = (1-1)+(2-6)+(2-10)+(5-2)+(5-1)+10 = 0-4-8+3+4+10 = 5. ✓ 5 mod 11 ≠ 0.\n\nSo the answer is 1.\n\nActually, let me reconsider whether there's a smarter approach. The polynomial f(x) = sum_{k=0}^{10} k! x^k. We want roots mod 11.\n\nNote that for k ≥ 11, k! ≡ 0 mod 11. But here we only go up to k=10.\n\nActually there's a nice identity. Consider sum_{k=0}^{p-1} k! x^k mod p. \n\nHmm, there's a known result. Let me think... Actually let me just trust my computation. I computed all 11 values and only n=7 gives 0 mod 11.\n\nLet me re-verify n=2 since it's easy to make errors.\n\nn=2: 2^k mod 11: 1,2,4,8,5,10,9,7,3,6,1 (order 10)\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1,2,8,48,10,100,45,14,15,6,10\nmod 11: 1,2,8,4,10,1,1,3,4,6,10\nsum: 1+2+8+4+10+1+1+3+4+6+10=50. 50 mod 11=6. ✓\n\nOK. The answer is 1.\n\nLet me also double check n=3.\n3^k mod 11: 1,3,9,5,4,1,3,9,5,4,1 (order 5)\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1,3,18,30,8,10,15,18,25,4,10\nmod 11: 1,3,7,8,8,10,4,7,3,4,10\nsum: 1+3+7+8+8+10+4+7+3+4+10=65. 65 mod 11=10. ✓\n\nn=4: 4^k mod 11: 1,4,5,9,3,1,4,5,9,3,1 (order 5)\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1,4,10,54,6,10,20,10,45,3,10\nmod 11: 1,4,10,10,6,10,9,10,1,3,10\nsum: 1+4+10+10+6+10+9+10+1+3+10=74. 74 mod 11=8. ✓\n\nn=5: 5^k mod 11: 1,5,3,4,9,1,5,3,4,9,1 (order 5)\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1,5,6,24,18,10,25,6,20,9,10\nmod 11: 1,5,6,2,7,10,3,6,9,9,10\nsum: 1+5+6+2+7+10+3+6+9+9+10=68. 68 mod 11=2. ✓\n\nn=6: 6^k mod 11: 1,6,3,7,9,10,5,8,4,2,1 (order 10)\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1,6,6,42,18,100,25,16,20,2,10\nmod 11: 1,6,6,9,7,1,3,5,9,2,10\nsum: 1+6+6+9+7+1+3+5+9+2+10=59. 59 mod 11=4. ✓\n\nn=8: 8^k mod 11: 1,8,9,6,4,10,3,2,5,7,1 (order 10)\nk!: 1,1,2,6,2,10,5,2,5,1,10\nproducts: 1,8,18,36,8,100,15,4,25,7,10\nmod 11: 1,8,7,3,8,1,4,4,3,7,10\nsum: 1+8+7+3+8+1+4+4+3+7+10=56. 56 mod 11=1. ✓\n\nn=9: 9^k mod 11: 1,9,4,3,5,1,9,4,3,5,