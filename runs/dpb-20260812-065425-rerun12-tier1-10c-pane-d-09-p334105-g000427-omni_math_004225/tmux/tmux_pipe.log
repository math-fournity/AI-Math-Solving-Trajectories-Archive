  [38;2;68;68;68m│[0m   [38;2;206;145;120mfrom itertools import permutations[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef d(p):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return sum(abs(p[k]-(k+1)) for k in range(len(p)))[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef inv(p):[0m
