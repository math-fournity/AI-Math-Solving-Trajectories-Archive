  [38;2;68;68;68m│[0m   [38;2;206;145;120mfrom collections import deque[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef find_min_reachable(initial_set, extra=6, max_states=2000000):[0m
