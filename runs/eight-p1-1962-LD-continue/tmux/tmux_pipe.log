  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport math[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef v2(n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    if n == 0: return 999[0m
