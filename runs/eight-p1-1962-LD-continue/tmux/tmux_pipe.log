  [38;2;68;68;68m│[0m   [38;2;206;145;120m# pq = 2^(2alpha-2)*(2^(2r)-1), p+q = 2a + 2^(alpha+r).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Since 2^(2r)-1 is odd: one of p,q carries all 2-power.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# p = 2^j * d, q = 2^(2alpha-2-j) * e, de = 2^(2r)-1, d,e odd, 0 <= j <= [0m
