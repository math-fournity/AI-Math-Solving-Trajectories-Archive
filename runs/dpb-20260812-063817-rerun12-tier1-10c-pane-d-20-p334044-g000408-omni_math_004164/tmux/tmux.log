  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport numpy as np[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mfrom scipy.optimize import least_squares[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mN = 15[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mxs = np.exp(np.linspace(-1.5, 1.5, N))[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef interp_f(x, xs, fvals):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    logx = np.log(np.clip(x, 1e-10, None))[0m
