  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (2^s+a)/A * [a*(2^s+a)/A - 2^alpha] = a + 2^(alpha+r)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# b * [a*b - 2^alpha] = a + 2^(alpha+r)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# a*b^2 - 2^alpha*b = a + 2^(alpha+r)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# a*b^2 - 2^alpha*b - a = 2^(alpha+r)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# So a*b^2 - 2^alpha*b - a = 2^(alpha+r). This is a quadratic in b:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# b = (2^alpha + sqrt(2^(2*alpha) + 4a*(a + 2^(alpha+r)))) / (2a)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
