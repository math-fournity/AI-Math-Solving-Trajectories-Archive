  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Study v_p(N(n)) for p=2 (odd n) and p=5 for larger n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Use recurrence N(r) = r*N(r-1) + 1 to compute N(n) mod p^a[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef N_mod(n, mod):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    """Compute N(n) mod mod using the sum directly with modular [0m
