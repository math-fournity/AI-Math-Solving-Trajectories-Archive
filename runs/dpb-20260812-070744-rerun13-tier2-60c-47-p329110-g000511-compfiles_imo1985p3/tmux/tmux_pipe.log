  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return [c % 2 for c in coeffs][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef poly_add(a, b):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    n = max(len(a), len(b))[0m
