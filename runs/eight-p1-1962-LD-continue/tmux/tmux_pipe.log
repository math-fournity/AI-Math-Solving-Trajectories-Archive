  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Key finding: for odd a >= 5, when A | (2^s+a) and b > a,[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# v_2(b^2-1) never equals alpha (or when it does, 2^r isn't a power of 2).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Let me understand WHY v_2(b^2-1) ≠ alpha for odd a >= 5.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# For odd a: alpha = v_2(a-1) + v_2(a+1). [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# One of a-1, a+1 has v_2 = 1, the other has v_2 >= 2.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# So alpha = 1 + beta where beta = v_2 of the other one >= 2.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# b = (2^s + a)/A, A = (a^2-1)/2^alpha = odd_part(a-1) * odd_part(a+1).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# b - 1 = (2^s + a - A)/A[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# b + 1 = (2^s + a + A)/A[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# v_2(b-1) = v_2(2^s + a - A) [since A is odd][0m
