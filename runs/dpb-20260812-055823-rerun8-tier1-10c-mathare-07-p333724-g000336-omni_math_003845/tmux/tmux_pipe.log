1A[19B[38;2;175;175;255m⠀⠴[0m[4B[2A[2C[?25h[?2026l[?2026h[21A[19B[1C[38;2;175;175;255m⠲[0m[4B[2A[2C[?25h[?2026l[?2026h[21A[J让我尝试一种基于代换的结构化方法。

[38;2;74;222;128m⏺ [0mRan command
  [38;2;68;68;68m│[0m $ [38;2;220;220;170mpython3[0m [38;2;79;193;255m-c[0m [38;2;206;145;120m"[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport numpy as np[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mr = 7**(1/3)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# We need: c*x^3 + (c - 7/16)*y^3 + 57/16 - 50*c/7 >= r*x / (y^3+1)^(1/3)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# for all x, y >= 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# c in [7/16, 399/800][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef check_inequality(c, n=200000):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    b = 57/16 - 50*c/7[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    alpha = c - 7/16[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    max_violation = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    worst = None[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for _ in range(n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        x = np.random.uniform(0, 5)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        y = np.random.uniform(0, 5)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        lhs = c*x**3 + alpha*y**3 + b[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        rhs = r * x / (y**3 + 1)**(1/3)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        v = rhs - lhs  # positive means violation[0m
