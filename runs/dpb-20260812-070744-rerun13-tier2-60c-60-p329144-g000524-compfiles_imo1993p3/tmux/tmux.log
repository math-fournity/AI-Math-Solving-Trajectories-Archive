  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # BFS from initial, but that's too expensive. [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # Let's do bidirectional or just DFS with memoization.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # Actually, let's do BFS but prune: we want to reach 1 piece.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # State = frozenset of occupied positions.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # For small n this might work. Let's try BFS.[0m
