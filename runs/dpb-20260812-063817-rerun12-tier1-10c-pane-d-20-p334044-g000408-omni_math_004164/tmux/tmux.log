  [38;2;68;68;68m│[0m   [38;2;206;145;120mres = least_squares(equations, f0, method='lm', max_nfev=5000)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint("From 1/x initial guess:")[0m
