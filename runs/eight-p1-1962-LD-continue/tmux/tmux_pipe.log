  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Let M = 2a + 2^(alpha+r). D = M^2 - 2^(2*alpha)*(2^(2r)-1).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# For D = m^2: M^2 - m^2 = 2^(2*alpha)*(2^(2r)-1).[0m
