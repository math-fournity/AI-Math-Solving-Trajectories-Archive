  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # Board coordinates: use 0-indexed, board from -extra to n-1+extra[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    extra = max_board_extra[0m
