  [38;2;68;68;68m│[0m   [38;2;206;145;120mres2 = least_squares(equations, f0p, method='lm', max_nfev=5000)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mprint("\nFrom perturbed initial guess:")[0m
