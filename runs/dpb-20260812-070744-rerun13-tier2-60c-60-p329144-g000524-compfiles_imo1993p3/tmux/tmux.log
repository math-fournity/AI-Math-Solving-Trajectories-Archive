  [38;2;68;68;68m│[0m   [38;2;206;145;120m    hi = n - 1 + extra[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    size = hi - lo + 1[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # Initial state: n×n block at (0..n-1, 0..n-1)[0m
