  [38;2;68;68;68m│[0m $ [38;2;220;220;170mcat[0m << [38;2;206;145;120m'EOF'[0m [38;2;255;255;255m>[0m /tmp/even_a_discriminant.py
  [38;2;68;68;68m│[0m   [38;2;206;145;120mimport math[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef v2(n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    if n == 0: return 999[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    c = 0[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    while n % 2 == 0:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        c += 1[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        n //= 2[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return c[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# For even a >= 4: a^2-1 is odd, b = 2^u * m, m = (2^s+a)/(a^2-1).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# (VIII): 2^(2u)*m*(a*m-1) = 2^(u+r) + a.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 2^(u+r) = 2^(2u)*m*(a*m-1) - a.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# For this to be a power of 2: 2^(2u)*m*(a*m-1) - a = 2^(u+r).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Let's think about this. For m odd:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# a = 2^k * a0 (a0 odd, k >= 2 for a >= 4 even).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# 2^(2u)*m*(a*m-1) - a = 2^(u+r).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# m*(a*m-1) is odd*odd = odd (a*m even, a*m-1 odd).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# So 2^(2u)*odd - 2^k * a0 = 2^(u+r).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# If 2u < k: v_2(LHS) = 2u. So u+r = 2u, r = u.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Then 2^(2u)*m*(a*m-1) - a = 2^(2u).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# m*(a*m-1) - a/2^(2u) = 1. But a/2^(2u) is not integer if 2u < k.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Actually LHS = 2^(2u)*m*(a*m-1) - 2^k*a0. v_2 = 2u (since 2u < k).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# = 2^(2u) * (m*(a*m-1) - 2^(k-2u)*a0) = 2^(2u).[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# So m*(a*m-1) - 2^(k-2u)*a0 = 1.[0m
