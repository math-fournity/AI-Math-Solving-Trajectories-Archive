  [38;2;68;68;68m│[0m   [38;2;206;145;120m    """Move chain [lo,hi] to front."""[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    chain = s[lo:hi+1][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    rest = s[:lo] + s[hi+1:][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return chain + rest[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef is_good(s, n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    """First n coins all same type."""[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    first = s[:n][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return all(c == first[0] for c in first)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mdef check(n, k, max_steps=10000):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    """Check if (n,k) works for all initial orderings. k is 1-indexed."""[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    k0 = k - 1  # 0-indexed[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    total = 2*n[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    # Generate all configurations with n A's and n B's[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for combo in combinations(range(total), n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        s = ['B'] * total[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        for i in combo:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            s[i] = 'A'[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        s = tuple(s)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        seen = set()[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        cur = s[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        found = False[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        for step in range(max_steps):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            if is_good(cur, n):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                found = True[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                break[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            if cur in seen:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m                break  # cycle detected, not good[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            seen.add(cur)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            lo, hi = get_chain(cur, k0)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            cur = tuple(move_chain(list(cur), lo, hi))[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        if not found:[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m            return False, s[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    return True, None[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120mfor n in range(1, 7):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    results = [][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for k in range(1, 2*n+1):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        ok, bad = check(n, k)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        results.append((k, ok))[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    good_ks = [k for k, ok in results if ok][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    bad_ks = [k for k, ok in results if not ok][0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m    print(f"n={n}: good k = {good_ks}, bad k = {bad_ks}")[0m
