[38;2;124;124;124mdef count_valid(n):[0m
[38;2;124;124;124m    count = 0[0m
[38;2;124;124;124m    for coloring in product([0,1,2], repeat=n):[0m
[38;2;124;124;124m        # Check all 3 colors used[0m
[38;2;124;124;124m        if len(set(coloring)) < 3:[0m
[38;2;124;124;124m            continue[0m
[38;2;124;124;124m        # Check condition[0m
[38;2;124;124;124m        valid = True[0m
[38;2;124;124;124m        # For each sum s, collect the color pairs of cross-color pairs[0m
[38;2;124;124;124m        # sums range from 1+2=3 to (n-1)+n=2n-1[0m
[38;2;124;124;124m        for s in range(3, 2*n):[0m
[38;2;124;124;124m            color_pairs = set()[0m
[38;2;124;124;124m            for i in range(1, s//2 + 1):  # i < j, i+j=s[0m
[38;2;124;124;124m                j = s - i[0m
[38;2;124;124;124m                if j > n or j <= i:[0m
[38;2;124;124;124m                    continue[0m
[38;2;124;124;124m                ci = coloring[i-1][0m
[38;2;124;124;124m                cj = coloring[j-1][0m
[38;2;124;124;124m                if ci != cj:[0m
[38;2;124;124;124m                    color_pairs.add(frozenset([ci, cj]))[0m
[38;2;124;124;124m            if len(color_pairs) > 1:[0m
[38;2;124;124;124m                valid = False[0m
[38;2;124;124;124m                break[0m
[38;2;124;124;124m        if valid:[0m
[38;2;124;124;124m            count += 1[0m
[38;2;124;124;124m    return count[0m

