  [38;2;68;68;68m│[0m   [38;2;206;145;120m# [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Let P = M - m, Q = M + m. PQ = 2^(2*alpha)*(2^(2r)-1), P+Q = 2M = 4a + [0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m2^(alpha+r+1).[0m
