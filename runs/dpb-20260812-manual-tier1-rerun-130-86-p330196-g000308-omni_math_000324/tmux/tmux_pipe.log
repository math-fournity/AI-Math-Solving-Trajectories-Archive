  [38;2;68;68;68m│[0m   [38;2;206;145;120m    for k in range(n-1, -1, -1):[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        term = term * (k+1) % mod  # n!/k! = n!/(k+1)! * (k+1)[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m        s = (s + term) % mod[0m
