&\text{阶3: } \{e,a,b\},\, \{e,w,d\},\, \{e,j,x\},\, \{e,y,l\}; \\
&\text{阶4: } \{e,p,q,r\},\, \{e,v,c,t\},\, \{e,n,h,k\},\, \{e,i,k,m\},\, \{e,g,c,u\},\, \{e,k,c,q\},\, \{e,f,q,s\}; \\
&\text{阶6: } \{e,g,i,a,b,s\},\, \{e,g,m,d,w,f\},\, \{e,i,u,l,y,f\},\, \{e,s,u,j,x,m\}; \\
&\text{阶8: } \{e,k,c,q,f,s,p,r\},\, \{e,k,c,q,g,u,t,v\},\, \{e,k,c,q,i,m,h,n\}; \\
