  [38;2;68;68;68m│[0m   [38;2;206;145;120m# Now let's handle ODD a >= 5.[0m
  [38;2;68;68;68m│[0m   [38;2;206;145;120m# For odd a: u = alpha = v_2(a^2-1), b is odd.[0m
