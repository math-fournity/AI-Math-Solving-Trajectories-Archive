      {
        "type": "function",
        "function": {
          "name": "get_output",
          "description": "Reads the output from a background shell process.\n\nUsage notes:\n- The shell_id argument is required (use the ID returned by the exec tool)\n- You can specify an optional timeout in milliseconds (up to 280000ms). Timeouts below 10000ms (10s) are raised to 10s; the default is 10s.\n- IMPORTANT: timeout is the MAX wait — this returns immediately when the process exits. If you want to wait for the command to finish, set a long timeout. If you want to quickly check status while working on other tasks in parallel, set a short timeout. Either way, do not repeatedly poll.\n- The process continues running after reading output\n- This will return the output of the most recently executed command in the shell if there is no current command running command\n",
          "parameters": {
            "required": [
              "shell_id"
            ],
            "properties": {
              "shell_id": {
                "description": "The ID of the shell to read output from.",
                "type": "string"
              },
              "timeout": {
                "description": "Optional timeout in milliseconds.",
                "type": "integer"
              },
              "incremental": {
                "description": "If true (default), returns the changes since your last read. For interactive shells whose\nscreen redraws in place (progress bars, block redraws), this is a unified diff so in-place\nline changes are shown as `-`old / `+`new; for plain append-only output it is the new lines.\nIf false, returns the full output buffer.",
                "type": "boolean"
              }
            },
            "type": "object",
            "additionalProperties": false
          }
        }
      },
